# /etc/systemd/system/codemap-api.service
# sudo systemctl daemon-reload && sudo systemctl enable --now codemap-api
[Unit]
Description=CodeMap API
After=network.target

[Service]
User=codemap
WorkingDirectory=/opt/codemap/server
ExecStart=/usr/bin/node --env-file=/opt/codemap/server/.env index.js
Restart=always
RestartSec=3
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/codemap/data
NoNewPrivileges=true
# Hardening: proces nie ma dostępu do /tmp innych usług, urządzeń, parametrów jądra ani surowych
# gniazd; nowe pliki (bloby, SQLite) powstają z prawami 0600/0700.
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
