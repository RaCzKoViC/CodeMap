# /etc/caddy/Caddyfile — CodeMap (frontend statyczny + API pod jedną domeną)
# Podmień domenę i przeładuj: sudo systemctl reload caddy
codemap.twojadomena.pl {
    encode zstd gzip

    handle /api/* {
        reverse_proxy 127.0.0.1:8787
    }

    handle {
        root * /opt/codemap/app
        file_server
        header /sw.js Cache-Control "no-cache"
        header /index.html Cache-Control "no-cache"
    }

    request_body {
        max_size 220MB
    }
}
