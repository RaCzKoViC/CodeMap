{
  "name": "codemap",
  "version": "1.3.0",
  "private": true,
  "description": "CodeMap — Kartografia Kodu: lokalna wizualizacja struktury kodu i zależności w stylu Maltego (czysty JS, bez build-stepu).",
  "license": "MIT",
  "homepage": "https://raczkovic.github.io/CodeMap/",
  "repository": {
    "type": "git",
    "url": "https://github.com/RaCzKoViC/CodeMap.git"
  },
  "engines": {
    "node": ">=20.6"
  },
  "bin": {
    "codemap": "cli/codemap.mjs"
  },
  "scripts": {
    "cli": "node cli/codemap.mjs",
    "cli-smoke": "node cli/codemap.mjs analyze . --quiet --exclude .claude --exclude integrations/vscode/app --exclude integrations/vscode/cli",
    "check": "node tools/check.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "lint": "eslint .",
    "smoke": "node tools/smoke.mjs",
    "bench": "node tools/bench.mjs",
    "bump": "node tools/bump.mjs",
    "serve": "python serve.py",
    "verify": "npm run check && npm test && npm run lint && npm run symbols-probe && npm run git-probe && npm run cli-smoke && npm run vscode-test",
    "symbols-probe": "node tools/symbols-probe.mjs",
    "git-probe": "node tools/git-probe.mjs",
    "vscode-test": "npm --prefix integrations/vscode test",
    "vscode-smoke": "npm --prefix integrations/vscode run smoke"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "tree-sitter-wasms": "^0.1.12",
    "web-tree-sitter": "^0.22.6"
  }
}
