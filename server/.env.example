# Skopiuj do .env i uzupełnij. Plik .env nigdy nie trafia do gita.

# Port API (Caddy proxuje /api/* na ten port)
PORT=8787

# Publiczny adres aplikacji — używany w linkach e-mail i kontroli nagłówka Origin.
# Dev:  http://localhost:8787
# Prod: https://codemap.twojadomena.pl
APP_ORIGIN=http://localhost:8787

# Wysyłka e-maili: console = linki drukowane na stdout (dev), resend = API resend.com
EMAIL_MODE=console
RESEND_API_KEY=
EMAIL_FROM=CodeMap <no-reply@twojadomena.pl>

# Limity przechowywania
DEFAULT_QUOTA_BYTES=2147483648
MAX_UPLOAD_BYTES=220000000

# Katalog danych (SQLite + bloby). Prod: /opt/codemap/data
DATA_DIR=./data

# production wyłącza serwowanie frontendu przez Node (robi to Caddy)
NODE_ENV=development
